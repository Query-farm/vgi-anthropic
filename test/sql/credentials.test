# name: test/sql/credentials.test
# description: Credential handling: org-scoped, workspace-scoped and rejected keys
# group: [anthropic]
#
# Runs offline against the fake Admin API (test/mock_api/server.py, fixed clock
# 2026-09-10 UTC) through ci/run-integration.sh; the key below is the fake's
# test key, not a credential.

require vgi

require-env VGI_ANTHROPIC_WORKER

require-env VGI_ANTHROPIC_BASE_URL

statement ok
ATTACH 'anthropic' (TYPE vgi, LOCATION '{VGI_ANTHROPIC_WORKER}');

# An `sk-ant-api03-` organization-scoped key reads the Admin API too.
statement ok
CREATE SECRET org_scoped (TYPE anthropic_admin, api_key 'sk-ant-api03-org-scoped-test-key');

query I
SELECT count(*) FROM anthropic.main.users;
----
5

statement ok
DROP SECRET org_scoped;

# A workspace-scoped key reads only the organization.
statement ok
CREATE SECRET ws_scoped (TYPE anthropic_admin, api_key 'sk-ant-api03-workspace-scoped-test-key');

query I
SELECT count(*) FROM anthropic.main.organization;
----
1

statement error
SELECT * FROM anthropic.main.users;
----
<REGEX>:.*workspace-scoped key can read `organization` and nothing else.*

statement ok
DROP SECRET ws_scoped;

# A rejected key reports the status.
statement ok
CREATE SECRET revoked (TYPE anthropic_admin, api_key 'sk-ant-admin01-revoked');

statement error
SELECT * FROM anthropic.main.organization;
----
<REGEX>:.*401.*

statement ok
DROP SECRET revoked;

# The key is redacted in duckdb_secrets().
statement ok
CREATE SECRET acme (TYPE anthropic_admin, api_key 'sk-ant-admin01-test-key');

query I
SELECT contains(secret_string, 'sk-ant-admin01-test-key') FROM duckdb_secrets() WHERE name = 'acme';
----
false
